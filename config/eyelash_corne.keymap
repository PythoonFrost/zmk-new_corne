#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <200>;       // 300                   // 0
};

&mmv { trigger-period-ms = <16>; };

&mt {
    tapping-term-ms = <120>;
    flavor = "tap-preferred";
};

&lt {
    tapping-term-ms = <135>;
    quick-tap-ms = <135>;
};

&sl { release-after-ms = <250>; };

/ {
    combos {
        compatible = "zmk,combos";

        clear_bt_R {
            bindings = <&bt BT_CLR>;
            key-positions = <42 28 0>;
            layers = <0 1>;
            require-prior-idle-ms = <200>;
            timeout-ms = <25>;
        };

        end_chord {
            bindings = <&kp END>;
            key-positions = <38 39>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <200>;
        };

        home_chord {
            bindings = <&kp HOME>;
            key-positions = <9 10>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <200>;
        };

        del_chord {
            bindings = <&kp DELETE>;
            key-positions = <37 38>;
            timeout-ms = <20>;
            layers = <0 1>;
            require-prior-idle-ms = <200>;
        };

        enter_chord {
            bindings = <&kp INSERT>;
            key-positions = <8 9>;
            layers = <0 1>;
            timeout-ms = <20>;
            require-prior-idle-ms = <200>;
        };

        R_Layer_Sys {
            bindings = <&mo 4>;
            key-positions = <41 46>;
            require-prior-idle-ms = <200>;
            slow-release;
            timeout-ms = <25>;
            layers = <0 1>;
        };

        L_Layer_Sys {
            bindings = <&mo 4>;
            key-positions = <28 43>;
            slow-release;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
            layers = <0 1>;
        };

        L_PUp {
            bindings = <&kp PAGE_UP>;
            key-positions = <10 11>;
            layers = <0 1>;
            timeout-ms = <20>;
            require-prior-idle-ms = <200>;
        };

        L_PDwn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <39 40>;
            layers = <0 1>;
            timeout-ms = <20>;
            require-prior-idle-ms = <200>;
        };

        R_H_Space {
            bindings = <&kp SPACE>;
            key-positions = <24 25>;
            timeout-ms = <35>;
            layers = <1>;
        };

        L_H_Space {
            bindings = <&kp SPACE>;
            key-positions = <16 15>;
            timeout-ms = <35>;
            layers = <1>;
        };

        R_mo {
            bindings = <&mo 2>;
            key-positions = <41 45>;
            timeout-ms = <35>;
            slow-release;
            layers = <0>;
            require-prior-idle-ms = <153>;
        };

        L_mo {
            bindings = <&mo 3>;
            key-positions = <44 28>;
            timeout-ms = <35>;
            slow-release;
            layers = <0>;
            require-prior-idle-ms = <153>;
        };

        L_HRM {
            bindings = <&tog 1>;
            key-positions = <43 44>;
            layers = <0 1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <200>;
        };

        R_HRM {
            bindings = <&tog 1>;
            key-positions = <45 46>;
            layers = <0 1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <200>;
        };
    };

    behaviors {
        hrm_r_layer: hrm_r_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <1 2 3 4 5 14 15 16 17 18 29 30 31 32 33>;
        };

        hrm_l_layer: hrm_l_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 22 23 24 25 26 36 37 38 39 40>;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <1 2 3 4 5 14 15 16 17 18 29 30 31 32 33 0 13 28 42 43 34>;
        };

        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 22 23 24 25 26 36 37 38 39 40 47 12 27 41 46 6 19 35 21 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R      &kp T                          &kp UP                       &kp Y  &kp U      &kp I          &kp O    &kp SEMI   &kp BACKSPACE
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F      &kp G                &kp LEFT  &kp C_PLAY_PAUSE  &kp RIGHT  &kp H  &kp J      &kp K          &kp L    &kp P      &mt RIGHT_SHIFT ENTER
&kp LCTRL       &kp Z  &kp X  &kp C         &kp V      &kp B  &kp C_MUTE              &kp DOWN                     &kp N  &kp M      &kp COMMA      &kp DOT  &kp SLASH  &kp RCTRL
                              &kp LEFT_ALT  &kp SPACE  &sl 2                                                       &sl 3  &kp SPACE  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        hrm_layer {
            display-name = "HRM";
            bindings = <
&kp TAB         &kp Q                &kp W           &kp E              &kp R             &kp T                                     &kp UP                       &kp Y             &kp U             &kp I               &kp O           &kp SEMI              &kp BACKSPACE
&kp LEFT_SHIFT  &hrm_l LEFT_SHIFT A  &hrm_l LCTRL S  &hrm_l LEFT_ALT D  &hrm_l_layer 3 F  &hrm_l_layer 2 G                &kp LEFT  &kp C_PLAY_PAUSE  &kp RIGHT  &hrm_r_layer 2 H  &hrm_r_layer 3 J  &hrm_r RIGHT_ALT K  &hrm_r RCTRL L  &hrm_r RIGHT_SHIFT P  &mt RIGHT_SHIFT ENTER
&kp LCTRL       &kp Z                &kp X           &kp C              &kp V             &kp B             &kp C_MUTE              &kp DOWN                     &kp N             &kp M             &kp COMMA           &kp DOT         &kp SLASH             &kp RCTRL
                                                     &kp LEFT_ALT       &kp SPACE         &sl 2                                                                  &sl 3             &kp SPACE         &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp ESCAPE  &kp TILDE  &kp BACKSLASH     &kp STAR           &kp PLUS   &kp AT                       &trans          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp HOME       &kp END           &kp COLON     &trans
&trans      &kp EXCL   &kp PIPE          &kp AMPS           &kp EQUAL  &kp COLON            &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp CARET      &kp DOLLAR        &kp POUND     &kp CAPSLOCK
&trans      &kp GRAVE  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp MINUS  &kp UNDER  &trans            &trans          &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION  &trans
                                         &trans             &trans     &trans                                       &trans                &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&kp ESCAPE  &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp F1  &kp F4                    &trans          &kp F7  &kp F10  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans
&trans      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp F2  &kp F5            &trans  &trans  &trans  &kp F8  &kp F11  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans
&trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp F3  &kp F6  &trans            &trans          &kp F9  &kp F12  &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans
                                        &kp N0        &trans  &trans                                    &trans  &trans   &kp KP_N0
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        system_layer {
            display-name = "FUNCT";
            bindings = <
&kp ESCAPE  &rgb_ug RGB_TOG  &kp C_AC_FORWARD  &kp C_NEXT      &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC                        &out OUT_USB              &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG  &trans
&trans      &kp C_MUTE       &kp C_REWIND      &kp C_PREVIOUS  &kp C_VOL_DN     &kp C_BRIGHTNESS_DEC            &bt BT_PRV  &bt BT_CLR    &bt BT_NXT  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_SPD  &mmv MOVE_UP     &trans
&trans      &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4          &trans                &out OUT_BLE              &rgb_ug RGB_EFF  &bl BL_TOG       &bl BL_CYCLE     &bl BL_DEC       &bl BL_INC       &trans
                                               &trans          &trans           &trans                                                                &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };
    };
};

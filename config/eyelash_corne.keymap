#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <200>;       // 300                   // 0
};

&mmv { trigger-period-ms = <16>; };

&mt {
    tapping-term-ms = <120>;
    flavor = "tap-preferred";
};

&lt {
    tapping-term-ms = <135>;
    quick-tap-ms = <135>;
};

&sl { release-after-ms = <300>; };

/ {
    combos {
        compatible = "zmk,combos";

        clear_bt_R {
            bindings = <&bt BT_CLR>;
            key-positions = <42 28 0>;
            layers = <0>;
            require-prior-idle-ms = <200>;
            timeout-ms = <25>;
        };

        end_chord {
            bindings = <&kp END>;
            key-positions = <24 25>;
            timeout-ms = <20>;
            layers = <0>;
        };

        home_chord {
            bindings = <&kp HOME>;
            key-positions = <9 10>;
            timeout-ms = <20>;
            layers = <0>;
        };

        del_chord {
            bindings = <&kp DELETE>;
            key-positions = <23 24>;
            timeout-ms = <20>;
            layers = <0>;
        };

        enter_chord {
            bindings = <&kp INSERT>;
            key-positions = <8 9>;
            layers = <0>;
            timeout-ms = <20>;
        };

        L_Layer_2 {
            bindings = <&mo 1>;
            key-positions = <44 43>;
            slow-release;
            timeout-ms = <25>;
            layers = <0>;
        };

        R_Layer_Sys {
            bindings = <&mo 3>;
            key-positions = <47 41>;
            require-prior-idle-ms = <200>;
            slow-release;
            timeout-ms = <25>;
            layers = <0>;
        };

        L_Layer_Sys {
            bindings = <&mo 3>;
            key-positions = <42 28>;
            slow-release;
            timeout-ms = <25>;
            require-prior-idle-ms = <200>;
            layers = <0>;
        };

        L_PUp {
            bindings = <&kp PAGE_UP>;
            key-positions = <10 11>;
            layers = <0>;
            timeout-ms = <20>;
        };

        L_PDwn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <25 26>;
            layers = <0>;
            timeout-ms = <20>;
        };

        R_layer_1 {
            bindings = <&mo 2>;
            key-positions = <45 46>;
            timeout-ms = <25>;
            layers = <0>;
            require-prior-idle-ms = <0>;
            slow-release;
        };
    };

    behaviors {
        hlt: hlt {
            compatible = "zmk,behavior-hold-tap";
            label = "Hold Layer Tap";
            bindings = <&kp>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <140>;
            flavor = "tap-unless-interrupted";
        };

        ltd_a3: ltd_a3 {
            compatible = "zmk,behavior-tap-dance";
            label = "Layer Tap Dance Alt SYS";
            #binding-cells = <0>;
            bindings = <&kp RCTRL>, <&mo 0>;

            tapping-term-ms = <170>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R      &kp T                          &kp UP                       &kp Y  &kp U      &kp I          &kp O    &kp SEMI  &kp BACKSPACE
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F      &kp G                &kp LEFT  &kp C_PLAY_PAUSE  &kp RIGHT  &kp H  &kp J      &kp K          &kp L    &kp P     &mt RIGHT_SHIFT ENTER
&kp LCTRL       &kp Z  &kp X  &kp C         &kp V      &kp B  &kp C_MUTE              &kp DOWN                     &kp N  &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RCTRL
                              &kp LEFT_ALT  &kp SPACE  &sl 2                                                       &sl 1  &kp SPACE  &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp ESCAPE  &kp SLASH     &kp PIPE          &kp BACKSLASH      &kp PERCENT     &kp CARET                    &trans          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp TILDE      &kp COLON         &kp SEMI      &trans
&trans      &kp ASTERISK  &kp AMPERSAND     &kp EXCLAMATION    &kp PLUS        &kp EQUAL            &trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN    &kp HASH          &kp DOLLAR    &kp CAPSLOCK
&trans      &kp GRAVE     &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp UNDERSCORE  &kp MINUS  &trans            &trans          &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION  &trans
                                            &trans             &trans          &trans                                       &trans                &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
&kp ESCAPE    &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp F1  &kp F4                    &trans                     &kp F7  &kp F10  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_NUMLOCK
&kp CAPSLOCK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp F2  &kp F5            &trans  &ext_power EP_TOG  &trans  &kp F8  &kp F11  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp SCROLLLOCK
&kp LEFT_GUI  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp F3  &kp F6  &trans            &trans                     &kp F9  &kp F12  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp PAUSE_BREAK
                                          &kp N0        &trans  &trans                                               &trans  &trans   &kp KP_N0
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        system_layer {
            display-name = "FUNCT";
            bindings = <
&kp ESCAPE    &rgb_ug RGB_TOG  &kp C_AC_FORWARD  &kp C_NEXT      &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC                        &out OUT_USB              &rgb_ug RGB_BRI  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_SPI  &rgb_ug RGB_TOG  &kp PRINTSCREEN
&kp CAPSLOCK  &kp C_MUTE       &kp C_REWIND      &kp C_PREVIOUS  &kp C_VOL_DN     &kp C_BRIGHTNESS_DEC            &bt BT_PRV  &bt BT_CLR    &bt BT_NXT  &rgb_ug RGB_BRD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_SPD  &mmv MOVE_UP     &kp CAPSLOCK
&trans        &bt BT_SEL 0     &bt BT_SEL 1      &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4          &trans                &out OUT_BLE              &rgb_ug RGB_EFF  &bl BL_TOG       &bl BL_CYCLE     &bl BL_DEC       &bl BL_INC       &trans
                                                 &trans          &trans           &trans                                                                &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;
        };
    };
};
